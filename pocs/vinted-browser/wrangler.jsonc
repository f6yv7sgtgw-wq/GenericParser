{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genericparser-vinted-poc",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": true
  }
}
