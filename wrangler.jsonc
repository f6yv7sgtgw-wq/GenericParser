{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "genericparser",
  "main": "src/generic_parser/cloudflare_worker.py",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["python_workers"],
  "services": [
    {
      "binding": "VINTED_BROWSER",
      "service": "genericparser-vinted-poc"
    }
  ],
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/version", "/diagnostics", "/search"]
  },
  "observability": {
    "enabled": true
  }
}
